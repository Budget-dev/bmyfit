rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Assessments, plans, orders, and webhook receipts are server-owned. The
    // Admin SDK is used by route handlers after verifying the Firebase UID.
    match /assessments/{assessmentId} { allow read, write: if false; }
    match /plans/{planId} { allow read, write: if false; }
    match /orders/{orderId} { allow read, write: if false; }
    match /paymentWebhooks/{eventId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    // User profile documents
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Personalized fitness and diet plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // User daily task completion logs
    match /user_logs/{logId} {
      allow read, write: if true;
    }

    // Health dossier & medical consultations
    match /medical_consultations/{consultationId} {
      allow read, write: if true;
    }

    // Fitness Assessments
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    // User subscriptions and entitlement synchronization
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow write: if true;
    }

    // Payment orders and webhook receipts (server-restricted)
    match /orders/{orderId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /paymentWebhooks/{eventId} {
      allow read, write: if false;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
